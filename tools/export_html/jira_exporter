(async () => {
  /*
   * Jira Ticket Exporter → clean self-contained HTML
   * ------------------------------------------------------------------
   * Open a Jira issue in the browser, then run this from the DevTools
   * Console. It pulls data from Jira's REST API (reliable — gets every
   * comment, not just the ones scrolled into view) and downloads ONE
   * styled .html file containing:
   *
   *   - Issue details  (reporter, assignee, status, priority, labels,
   *     components, fix versions, created/updated)
   *   - Description    (rendered → clean text)
   *   - All comments   (paged, mentions preserved)
   *   - Changelog      (field history: old → new)
   *
   * Works on Jira Cloud (REST v3) and Server/Data Center (REST v2);
   * it auto-detects which one to use. Uses your existing login session.
   * ------------------------------------------------------------------
   */

  /* ------------------------------ helpers ------------------------------ */

  function escapeHtml(v) {
    return String(v ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function normalize(v) {
    return String(v ?? "")
      .replace(/\r/g, "")
      .replace(/\u00a0/g, " ")
      .trim();
  }

  // Rendered HTML (Jira renderedFields/renderedBody) → readable plain text.
  function htmlToText(html) {
    if (!html) return "";
    const tmp = document.createElement("div");
    tmp.innerHTML = String(html);
    tmp.querySelectorAll("script,style").forEach((n) => n.remove());
    tmp.querySelectorAll("br").forEach((br) => br.replaceWith("\n"));
    tmp
      .querySelectorAll("p,div,li,tr,h1,h2,h3,h4,h5,h6")
      .forEach((el) => el.append("\n"));
    return (tmp.innerText || tmp.textContent || "")
      .replace(/\n{3,}/g, "\n\n")
      .replace(/\u00a0/g, " ")
      .trim();
  }

  // Jira Cloud ADF (Atlassian Document Format) JSON → text.
  function adfToText(node) {
    if (!node) return "";
    if (Array.isArray(node)) return node.map(adfToText).join("");
    if (node.type === "text") return node.text || "";
    if (node.type === "hardBreak") return "\n";
    if (node.type === "mention") return "@" + (node.attrs?.text || node.attrs?.id || "");
    if (node.type === "emoji") return node.attrs?.shortName || "";
    const inner = node.content ? adfToText(node.content) : "";
    const block =
      node.type === "paragraph" ||
      node.type === "heading" ||
      node.type === "listItem" ||
      node.type === "blockquote" ||
      node.type === "codeBlock";
    return block ? inner + "\n" : inner;
  }

  async function fetchJson(url, headers) {
    const res = await fetch(url, {
      method: "GET",
      credentials: "include",
      cache: "no-store",
      headers: { Accept: "application/json", ...headers },
    });
    if (!res.ok) {
      const body = await res.text();
      throw new Error(`HTTP ${res.status} for ${url}\n${body.slice(0, 400)}`);
    }
    return res.json();
  }

  function getIssueKey() {
    const p = new URLSearchParams(location.search);
    const fromParam = p.get("selectedIssue") || p.get("issueKey") || p.get("issue");
    if (fromParam && /^[A-Z][A-Z0-9]+-\d+$/i.test(fromParam)) return fromParam.toUpperCase();
    const path = location.pathname.match(/\/browse\/([A-Z][A-Z0-9]+-\d+)/i);
    if (path) return path[1].toUpperCase();
    const any = location.href.match(/\b([A-Z][A-Z0-9]+-\d+)\b/);
    return any ? any[1].toUpperCase() : null;
  }

  /* ------------------------------- run ------------------------------- */

  const key = getIssueKey();
  if (!key) {
    alert("Jira issue key (e.g. DEV-20396) not found.\nOpen the actual issue and run again.");
    return;
  }

  const headers = { "X-Atlassian-Token": "no-check" };
  const failures = [];

  // Try Cloud v3 first, fall back to Server/DC v2.
  let apiBase = "/rest/api/3";
  const issueUrl = (base) =>
    `${base}/issue/${encodeURIComponent(key)}?expand=changelog,renderedFields&fields=*all`;

  let issue;
  try {
    issue = await fetchJson(issueUrl(apiBase), headers);
  } catch (_) {
    apiBase = "/rest/api/2";
    try {
      issue = await fetchJson(issueUrl(apiBase), headers);
    } catch (e) {
      console.error(e);
      alert(`Could not read issue ${key} from the Jira API.\n\n${e.message}`);
      return;
    }
  }

  const f = issue.fields || {};
  const rf = issue.renderedFields || {};

  // ---- Comments (paged) ----
  const comments = [];
  let startAt = 0;
  while (true) {
    let data;
    try {
      data = await fetchJson(
        `${apiBase}/issue/${encodeURIComponent(key)}/comment?expand=renderedBody&startAt=${startAt}&maxResults=100&orderBy=created`,
        headers
      );
    } catch (e) {
      failures.push("comments");
      console.warn("Comment fetch failed:", e);
      break;
    }
    const page = Array.isArray(data.comments) ? data.comments : [];
    comments.push(...page);
    startAt += page.length;
    if (!page.length || startAt >= (data.total || 0)) break;
  }

  /* ---------------------------- build entries ---------------------------- */

  const entries = [];

  // 1) Issue details + description (first).
  const description =
    htmlToText(rf.description) ||
    (f.description && typeof f.description === "object"
      ? adfToText(f.description).trim()
      : normalize(f.description));

  const environment =
    htmlToText(rf.environment) ||
    (f.environment && typeof f.environment === "object"
      ? adfToText(f.environment).trim()
      : normalize(f.environment));

  const people = [
    f.reporter && `Reporter: ${normalize(f.reporter.displayName || f.reporter.name)}`,
    f.assignee
      ? `Assignee: ${normalize(f.assignee.displayName || f.assignee.name)}`
      : "Assignee: Unassigned",
    f.priority && `Priority: ${normalize(f.priority.name)}`,
    f.status && `Status: ${normalize(f.status.name)}`,
    f.resolution && `Resolution: ${normalize(f.resolution.name)}`,
    Array.isArray(f.labels) && f.labels.length && `Labels: ${f.labels.join(", ")}`,
    Array.isArray(f.components) && f.components.length &&
      `Components: ${f.components.map((c) => normalize(c.name)).join(", ")}`,
    Array.isArray(f.fixVersions) && f.fixVersions.length &&
      `Fix versions: ${f.fixVersions.map((v) => normalize(v.name)).join(", ")}`,
  ]
    .filter(Boolean)
    .join("\n");

  // Attachments list (filename + link).
  const attachments = Array.isArray(f.attachment)
    ? f.attachment
        .map((a) => `- ${normalize(a.filename)} (${normalize(a.created)})\n  ${normalize(a.content)}`)
        .join("\n")
    : "";

  entries.push({
    type: "Issue details",
    date: normalize(f.created),
    author: normalize(f.reporter?.displayName || f.reporter?.name),
    heading: normalize(f.summary) || key,
    content: [
      people,
      description ? `\nDescription:\n${description}` : "",
      environment ? `\nEnvironment:\n${environment}` : "",
      attachments ? `\nAttachments:\n${attachments}` : "",
    ]
      .filter(Boolean)
      .join("\n"),
  });

  // 2) Comments.
  for (const c of comments) {
    const body =
      htmlToText(c.renderedBody) ||
      (c.body && typeof c.body === "object" ? adfToText(c.body).trim() : normalize(c.body));
    entries.push({
      type: "Comment",
      date: normalize(c.created),
      author: normalize(c.author?.displayName || c.author?.name),
      heading: "Comment",
      content: body,
    });
  }

  // 3) Changelog.
  const histories = issue.changelog?.histories || [];
  for (const h of histories) {
    const items = (h.items || [])
      .map((it) => {
        const from = normalize(it.fromString ?? it.from);
        const to = normalize(it.toString ?? it.to);
        return `${it.field}: ${from || "(empty)"} \u2192 ${to || "(empty)"}`;
      })
      .join("\n");
    entries.push({
      type: "Field change",
      date: normalize(h.created),
      author: normalize(h.author?.displayName || h.author?.name),
      heading: "Changelog",
      content: items,
    });
  }

  // Sort chronologically (issue details stays first via its created date).
  entries.sort((a, b) => {
    const da = Date.parse(a.date), db = Date.parse(b.date);
    if (Number.isNaN(da) || Number.isNaN(db)) return a.date.localeCompare(b.date);
    return da - db;
  });

  /* ------------------------------ HTML out ------------------------------ */

  const activityHtml = entries
    .map(
      (e, i) => `
<section class="entry">
  <div class="number">${i + 1}</div>
  <div class="card">
    <div class="header">
      <span class="type">${escapeHtml(e.type)}</span>
      <span class="date">${escapeHtml(e.date)}</span>
    </div>
    ${e.author ? `<div class="author">${escapeHtml(e.author)}</div>` : ""}
    ${e.heading ? `<h2>${escapeHtml(e.heading)}</h2>` : ""}
    <div class="body">${escapeHtml(e.content)}</div>
  </div>
</section>`
    )
    .join("\n");

  const warn = failures.length
    ? `<section class="warning"><strong>Some data could not be fetched:</strong> ${escapeHtml(
        failures.join(", ")
      )}</section>`
    : "";

  const title = key;
  const summary = normalize(f.summary);

  const html = `<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapeHtml(title)} — ${escapeHtml(summary)}</title>
<style>
  body{max-width:1100px;margin:32px auto;padding:0 24px 60px;color:#202124;background:#fff;
    font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.55}
  .page-header{margin-bottom:24px;padding-bottom:16px;border-bottom:2px solid #d8dde6}
  h1{margin:0 0 6px;font-size:26px}.description{margin:0 0 10px;font-size:15px}
  .metadata{color:#5f6368;font-size:12px;white-space:pre-line;overflow-wrap:anywhere}
  .summary{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0 22px}
  .summary span{padding:8px 12px;background:#f1f3f4;border-radius:6px}
  .warning{margin-bottom:22px;padding:12px 14px;color:#6d4c00;background:#fff4ce;
    border:1px solid #e5c365;border-radius:6px}
  .entry{display:grid;grid-template-columns:38px 1fr;gap:14px;margin-bottom:18px;break-inside:avoid}
  .number{display:flex;align-items:center;justify-content:center;width:32px;height:32px;color:#fff;
    background:#4f5bd5;border-radius:50%;font-weight:bold}
  .card{padding:16px 18px;border:1px solid #d8dde6;border-radius:8px}
  .header{display:flex;justify-content:space-between;gap:20px;margin-bottom:5px}
  .type{color:#3f51b5;font-weight:bold}.date{color:#5f6368;font-size:12px}
  .author{margin-bottom:8px;font-weight:bold}h2{margin:8px 0;font-size:15px}
  .body{white-space:pre-wrap;overflow-wrap:anywhere}
  @media print{body{max-width:none;margin:0}}
</style></head><body>
<header class="page-header">
  <h1>${escapeHtml(title)}</h1>
  ${summary ? `<p class="description">${escapeHtml(summary)}</p>` : ""}
  <div class="metadata">Source: <a href="${escapeHtml(location.href)}">${escapeHtml(location.href)}</a>
Issue type: ${escapeHtml(normalize(f.issuetype?.name))}
Status: ${escapeHtml(normalize(f.status?.name))}
Created: ${escapeHtml(normalize(f.created))} · Updated: ${escapeHtml(normalize(f.updated))}
API: ${escapeHtml(apiBase)} · Exported: ${escapeHtml(new Date().toLocaleString())}</div>
</header>
<div class="summary">
  <span>Total: ${entries.length}</span>
  <span>Comments: ${comments.length}</span>
  <span>Field changes: ${histories.length}</span>
</div>
${warn}
<main>${activityHtml}</main>
</body></html>`;

  /* ------------------------------ download ------------------------------ */

  const blob = new Blob([html], { type: "text/html;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${key}_Activity_${new Date().toISOString().slice(0, 10)}.html`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);

  console.log({
    issue: key,
    comments: comments.length,
    fieldChanges: histories.length,
    total: entries.length,
    api: apiBase,
    failures,
  });
})();
